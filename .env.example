# Example configuration. Copy to .env for reference only:
#
#   cp .env.example .env
#
# The API does not read .env files. Export the variables in your shell or pass
# them with `docker run -e ...`. Do not commit real credentials.

# Deployment environment: development, staging, or production.
APP_ENV=development

# Listen address for the HTTP server.
HTTP_ADDR=:8080

# Maximum duration for reading an entire request, including the body.
HTTP_READ_TIMEOUT=10s

# Maximum duration for writing a response.
HTTP_WRITE_TIMEOUT=15s

# Maximum duration a keep-alive connection may stay idle.
HTTP_IDLE_TIMEOUT=60s

# Maximum duration for reading request headers. Limits slow-header clients.
HTTP_READ_HEADER_TIMEOUT=5s

# Grace period for in-flight requests during graceful shutdown.
HTTP_SHUTDOWN_TIMEOUT=15s

# Minimum log level: debug, info, warn, or error.
LOG_LEVEL=info